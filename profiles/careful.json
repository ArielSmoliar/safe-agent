{
  "profile": "careful",
  "description": "Read freely; approve every mutation and shell command. Hard-block destructive Bash.",
  "tools": {
    "allow": ["Read", "Grep", "Glob"],
    "gate": ["Edit", "Write", "NotebookEdit", "Bash", "Agent"],
    "deny": []
  },
  "patterns": {
    "deny": [
      { "tool": "Bash", "match": "rm[[:space:]]+-[a-zA-Z]*r[a-zA-Z]*f|rm[[:space:]]+-[a-zA-Z]*f[a-zA-Z]*r|git[[:space:]]+push[[:space:]].*(--force([[:space:]]|$)|-f([[:space:]]|$))", "reason": "destructive command (forced delete or force-push; --force-with-lease is allowed)" }
    ],
    "gate": [
      { "tool": "Write", "match": "\\.env|\\.pem|\\.key|credentials", "reason": "write to a sensitive path" }
    ]
  },
  "default": "defer"
}
